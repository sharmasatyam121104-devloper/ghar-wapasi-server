# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=8080

# Where the browser app runs. Used for CORS and cookie decisions.
CLIENT_URL=http://localhost:5173

# Mongo connection. DB_URL is the server only - the database name is appended
# to it at connect time, so do not put the database name in here as well.
# The server still starts without these: it logs the failure, /health reports
# "disconnected", and every /api route answers 503 until Mongo is reachable.
DB_URL=mongodb://127.0.0.1:27017
DB_NAME=ghar_wapsi
