# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=8080

# Where the browser app runs. Used for CORS and cookie decisions.
CLIENT_URL=http://localhost:5173

# Mongo connection. DB_URL is the server only - the database name is appended
# to it at connect time, so do not put the database name in here as well.
# The server still starts without these: it logs the failure, /health reports
# "disconnected", and every /api route answers 503 until Mongo is reachable.
DB_URL=mongodb://127.0.0.1:27017
DB_NAME=ghar_wapsi

# OTP policy for contact changes. The defaults are the production-safe values;
# nothing here needs changing to run locally.
#   TTL             how long a code stays usable
#   RESEND_COOLDOWN seconds to wait before another code for the same purpose
#   MAX_ATTEMPTS    wrong guesses before the code is burned
#   MAX_PER_HOUR    codes per hour for one purpose, whatever the cooldown says
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
